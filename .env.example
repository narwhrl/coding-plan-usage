# 访问口令（可选）：设置后所有页面与 API 需登录；留空则免认证。
# 免认证只适合本机/内网。暴露到公网前必须设置，面板会在未设置时显示警告。
ACCESS_PASSWORD=

# 凭证加密主密钥（必填）：任意非空字符串，内部经 scrypt 派生 AES-256-GCM 密钥。
# 一旦设置请勿更换，否则已保存的 API Key / OAuth 凭证将无法解密（需重新粘贴）。
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# SQLite 文件路径（Docker 内默认 /data/app.db，挂载卷持久化）
SQLITE_PATH=./data/app.db

# 时区（影响 GLM model-usage 查询窗口的本地时间构造）
TZ=Asia/Shanghai
